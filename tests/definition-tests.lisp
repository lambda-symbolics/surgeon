(in-package #:surgeon)

;;;; -- Definition and Undo Tests --

(defun definition-tests--install (package source &key previous-source)
  "Capture an undo for SOURCE in PACKAGE, install it, and return the undo function."
  (let* ((definition (read-one-form source :package package))
         (undo (definition-undo-capture (first definition) definition package
                                        :previous-source previous-source)))
    (let ((*package* package))
      (eval definition))
    undo))

(define-test definition-signatures
  (test-assert (definition-form-p '(defun f () nil)))
  (test-assert (definition-form-p '(defun (setf f) (value) value)))
  (test-assert (not (definition-form-p '(progn (defun f () nil)))))
  (test-assert (not (definition-form-p '(defun "f" () nil))))
  (test-assert (not (definition-form-p '(defun))))
  (test-equal '(defun f) (definition-signature '(defun f (x) x)))
  (test-equal '(defmethod g (:around) (string t))
              (definition-signature '(defmethod g :around ((x string) y) x)))
  (test-equal '(defmethod g () ((eql :a)))
              (definition-signature '(defmethod g ((x (eql :a))) x)))
  (test-assert (string/= (definition-key '(defmethod g :around ((x string))))
                         (definition-key '(defmethod g ((x string)))))
               "method qualifiers distinguish keys")
  (test-equal "(defvar *x*)" (let ((*package* (find-package '#:surgeon)))
                               (definition-key '(defvar *x* 1))))
  (test-equal 'f (definition-name-symbol '(setf f)))
  (test-equal "SURGEON" (definition-home-package-name '(defun f () nil)))
  (test-signals definition-unsupported (definition-signature '(defmethod g :around)))
  (let ((method (defmethod definition-operator-p ((operator (eql 'define-gizmo))) t)))
    (unwind-protect
         (test-assert (definition-form-p '(define-gizmo g)) "hosts add defining operators")
      (remove-method #'definition-operator-p method)))
  (test-assert (not (definition-form-p '(define-gizmo g)))))

(define-test function-and-variable-undo
  (call-with-scratch-package
   (lambda (package)
     (flet ((value (source)
              (scratch-evaluate package source)))
       (let ((undo (definition-tests--install package "(defun f () :new)")))
         (test-equal :new (value "(f)"))
         (funcall undo)
         (test-assert (not (fboundp (find-symbol "F" package))) "a new function is removed"))
       (value "(defun f () :old)")
       (funcall (definition-tests--install package "(defun f () :new)"))
       (test-equal :old (value "(f)") :description "a replaced function returns")
       (value "(defmacro m () :old)")
       (funcall (definition-tests--install package "(defmacro m () :new)"))
       (test-equal :old (value "(m)") :description "a replaced macro returns")
       (funcall (definition-tests--install package "(defun m () :function)"))
       (test-equal :old (value "(m)") :description "a macro replaced by a function returns")
       (value "(defun n () :function)")
       (funcall (definition-tests--install package "(defmacro n () :macro)"))
       (test-equal :function (value "(n)") :description "a function replaced by a macro returns")
       (value "(defun c (x) x)")
       (funcall (definition-tests--install package "(define-compiler-macro c (x) x)"))
       (test-assert (null (compiler-macro-function (find-symbol "C" package))))
       (let ((undo (definition-tests--install package "(defvar *v* :new)")))
         (test-equal :new (value "*v*"))
         (funcall undo)
         (test-assert (not (boundp (find-symbol "*V*" package))) "a new variable is unbound"))
       (value "(defparameter *p* :old)")
       (funcall (definition-tests--install package "(defparameter *p* :new)"))
       (test-equal :old (value "*p*"))
       (let ((undo (definition-tests--install package "(deftype small () '(integer 0 9))")))
         (test-assert (typep 3 (find-symbol "SMALL" package)))
         (funcall undo)
         (test-assert (null (symbol-definition-kinds (find-symbol "SMALL" package)))
                      "a new type is forgotten"))))))

(define-test method-undo
  (call-with-scratch-package
   (lambda (package)
     (flet ((value (source)
              (scratch-evaluate package source)))
       (let ((undo (definition-tests--install package "(defmethod g ((x integer)) :new)")))
         (test-equal :new (value "(g 1)"))
         (funcall undo)
         (test-assert (not (fboundp (find-symbol "G" package)))
                      "a generic function created by the method is removed"))
       (value "(defgeneric h (x))")
       (value "(defmethod h ((x integer)) :old)")
       (value "(defmethod h :around ((x integer)) (list :around (call-next-method)))")
       (funcall (definition-tests--install package "(defmethod h ((x integer)) :new)"))
       (test-equal '(:around :old) (value "(h 1)") :description "the replaced method returns")
       (funcall (definition-tests--install package "(defmethod h ((x (eql 2))) :two)"))
       (test-equal '(:around :old) (value "(h 2)") :description "an EQL method is removed")))))

(define-test class-undo
  (call-with-scratch-package
   (lambda (package)
     (flet ((value (source)
              (scratch-evaluate package source)))
       (let ((undo (definition-tests--install
                    package "(defclass box () ((size :initarg :size :reader box-size)))")))
         (test-equal 3 (value "(box-size (make-instance 'box :size 3))"))
         (funcall undo)
         (test-assert (and (null (find-class (find-symbol "BOX" package) nil))
                           (not (fboundp (find-symbol "BOX-SIZE" package))))
                      "a new class and its reader are removed"))
       (let ((old "(defclass crate () ((size :initarg :size :reader crate-size)))"))
         (value old)
         (test-signals definition-irreversible
           (definition-tests--install package "(defclass crate () ())"))
         (funcall (definition-tests--install package "(defclass crate () ())"
                                             :previous-source old))
         (test-equal 4 (value "(crate-size (make-instance 'crate :size 4))")
                     :description "the previous class source is reinstalled"))
       (test-signals definition-irreversible
         (definition-undo-capture 'progn '(progn) package))))))
